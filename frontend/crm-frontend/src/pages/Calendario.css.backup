/* ============================================
   🎨 CALENDÁRIO ULTRA MODERNO E ELEGANTE 
   ============================================ */

/* Container Principal com Efeitos Visuais */
.calendario-container {
  padding: 20px;
  max-width: 1400px;
  margin: 0 auto;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.calendario-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 50%, rgba(120, 119, 241, 0.3) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255, 119, 48, 0.3) 0%, transparent 50%),
    radial-gradient(circle at 40% 80%, rgba(17, 153, 142, 0.3) 0%, transparent 50%);
  pointer-events: none;
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(1deg); }
}

/* Header do Calendário */
.calendario-header {
  text-align: center;
  margin-bottom: 40px;
  padding: 40px;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-radius: 30px;
  box-shadow: 
    0 25px 50px rgba(0, 0, 0, 0.15),
    0 0 0 1px rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
  transform: translateY(0);
  transition: transform 0.3s ease;
}

.calendario-header:hover {
  transform: translateY(-5px);
}

.calendario-header h1 {
  background: linear-gradient(135deg, #667eea, #764ba2, #FF9800);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0 0 15px 0;
  font-size: 3.5rem;
  font-weight: 800;
  text-shadow: 0 4px 20px rgba(102, 126, 234, 0.3);
  animation: glow 3s ease-in-out infinite alternate;
}

@keyframes glow {
  from { filter: drop-shadow(0 0 20px rgba(102, 126, 234, 0.5)); }
  to { filter: drop-shadow(0 0 35px rgba(118, 75, 162, 0.7)); }
}

.calendario-header p {
  color: #64748b;
  margin: 0;
  font-size: 1.3rem;
  font-weight: 500;
  opacity: 0.8;
}

/* Wrapper do Calendário */
.calendar-wrapper {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(25px);
  border-radius: 35px;
  box-shadow: 
    0 30px 60px rgba(0, 0, 0, 0.2),
    0 0 0 1px rgba(255, 255, 255, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
  overflow: hidden;
  padding: 30px;
  position: relative;
  z-index: 1;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.calendar-wrapper:hover {
  transform: translateY(-2px);
  box-shadow: 
    0 35px 70px rgba(0, 0, 0, 0.25),
    0 0 0 1px rgba(255, 255, 255, 0.3);
}

/* Controles do Calendário */
.calendar-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  padding: 25px 30px;
  background: linear-gradient(135deg, #FF9800 0%, #FF5722 100%);
  border-radius: 25px;
  color: white;
  box-shadow: 
    0 15px 35px rgba(255, 152, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  position: relative;
  overflow: hidden;
}

.calendar-controls::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transform: rotate(45deg);
  animation: shine 3s infinite;
}

@keyframes shine {
  0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
  50% { transform: translateX(100%) translateY(100%) rotate(45deg); }
  100% { transform: translateX(200%) translateY(200%) rotate(45deg); }
}

.nav-btn {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: white;
  padding: 15px 25px;
  border-radius: 15px;
  cursor: pointer;
  font-weight: 700;
  font-size: 1rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}

.nav-btn:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
}

.nav-btn:active {
  transform: translateY(-1px) scale(1.02);
}

.month-year {
  margin: 0;
  font-size: 2.2rem;
  font-weight: 700;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  position: relative;
  z-index: 1;
}

/* Calendar Legend */
.calendar-legend {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-bottom: 20px;
  padding: 15px;
  background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
  border-radius: 10px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  color: #495057;
}

.legend-indicator {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.legend-indicator.servico .strong-indicator {
  width: 12px;
  height: 12px;
  background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
  border-radius: 3px;
  box-shadow: 0 2px 6px rgba(245, 124, 0, 0.4);
}

.legend-indicator.recontato .dot-indicator {
  width: 8px;
  height: 8px;
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 50%;
  box-shadow: 0 2px 6px rgba(25, 118, 210, 0.4);
}

/* Calendar Grid */
.calendar-grid {
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

.calendar-header-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
}

.header-day {
  padding: 15px;
  text-align: center;
  font-weight: 600;
  color: white;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: white;
}

.calendar-day {
  position: relative;
  min-height: 80px;
  padding: 10px;
  border: 1px solid #e9ecef;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.calendar-day:hover {
  background: #f8f9fa;
  transform: scale(1.02);
  z-index: 2;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.calendar-day.empty {
  background: #f8f9fa;
  cursor: default;
  pointer-events: none;
}

.calendar-day.today {
  background: linear-gradient(135deg, #fff8e1, #ffecb3);
  border: 2px solid #FF9800;
  font-weight: bold;
}

.calendar-day.today:hover {
  background: linear-gradient(135deg, #ffecb3, #ffd54f);
}

.calendar-day.has-events {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
}

.calendar-day.has-events:hover {
  background: linear-gradient(135deg, #bbdefb, #90caf9);
}

.day-number {
  font-size: 1.1rem;
  font-weight: 600;
  color: #2d3436;
}

.calendar-day.today .day-number {
  color: #2d3436;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

/* Event Indicators */
.events-indicators {
  display: flex;
  gap: 4px;
  margin-top: 5px;
  flex-wrap: wrap;
}

.indicator {
  display: flex;
  align-items: center;
  justify-content: center;
}

.strong-indicator {
  width: 10px;
  height: 10px;
  background: linear-gradient(135deg, #FF9800, #F57C00);
  border-radius: 2px;
  box-shadow: 0 2px 4px rgba(245, 124, 0, 0.4);
  animation: pulse 2s infinite;
}

.dot-indicator {
  width: 6px;
  height: 6px;
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 50%;
  box-shadow: 0 1px 3px rgba(25, 118, 210, 0.4);
  animation: blink 3s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

@keyframes blink {
  0%, 90%, 100% { opacity: 1; }
  95% { opacity: 0.3; }
}

/* Loading */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 20px;
}

.loading-spinner {
  width: 50px;
  height: 50px;
  border: 4px solid #e9ecef;
  border-top: 4px solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Modal Styles */
.calendar-modal {
  max-width: 600px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
}

.events-section {
  margin-bottom: 25px;
}

.events-section h3 {
  color: #2c3e50;
  margin-bottom: 15px;
  padding-bottom: 8px;
  border-bottom: 2px solid #e9ecef;
  font-size: 1.3rem;
}

.events-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.event-card {
  padding: 15px;
  border-radius: 12px;
  border-left: 4px solid;
  transition: all 0.3s ease;
}

.event-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.servico-card {
  background: linear-gradient(135deg, #fff8e1, #ffecb3);
  border-left-color: #FF9800;
}

.recontato-card {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  border-left-color: #2196F3;
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.event-time {
  background: #FF9800;
  color: white;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
}

.event-value {
  background: #4CAF50;
  color: white;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
}

.event-status {
  background: #2196F3;
  color: white;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: capitalize;
}

.event-title {
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 5px;
  font-size: 1.1rem;
}

.event-client {
  color: #7f8c8d;
  font-size: 0.95rem;
  margin-bottom: 5px;
}

.event-obs {
  color: #636e72;
  font-size: 0.9rem;
  font-style: italic;
  background: rgba(255, 255, 255, 0.6);
  padding: 8px;
  border-radius: 6px;
  margin-top: 8px;
}

.no-events {
  text-align: center;
  padding: 40px 20px;
  color: #7f8c8d;
}

.no-events-icon {
  font-size: 4rem;
  margin-bottom: 20px;
  opacity: 0.7;
}

.no-events h3 {
  color: #2c3e50;
  margin: 0 0 10px 0;
  font-size: 1.4rem;
}

.no-events p {
  font-size: 1rem;
  margin: 0 0 20px 0;
  line-height: 1.5;
}

.suggestions {
  background: #f8f9fa;
  border-radius: 10px;
  padding: 20px;
  margin-top: 20px;
}

.suggestions p {
  margin: 0 0 15px 0;
  color: #495057;
  font-weight: 500;
}

.suggestion-links {
  display: flex;
  gap: 15px;
  justify-content: center;
  flex-wrap: wrap;
}

.suggestion-links span {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  color: white;
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: default;
}

@media (max-width: 768px) {
  .suggestion-links {
    flex-direction: column;
    align-items: center;
  }
}

/* Responsive Design */
@media (max-width: 768px) {
  .calendario-container {
    padding: 10px;
  }
  
  .calendar-controls {
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }
  
  .nav-btn {
    padding: 8px 16px;
    font-size: 0.9rem;
  }
  
  .month-year {
    font-size: 1.5rem;
  }
  
  .calendar-legend {
    flex-direction: column;
    gap: 15px;
    align-items: center;
  }
  
  .calendar-day {
    min-height: 60px;
    padding: 8px;
  }
  
  .day-number {
    font-size: 1rem;
  }
  
  .calendar-modal {
    width: 95%;
    max-height: 90vh;
  }
  
  .event-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
}
